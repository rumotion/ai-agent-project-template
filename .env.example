# Copy this file to `.env` and fill in local values.
# Never commit real secrets. `.env` is gitignored; `.env.example` is not.

# --- Model / provider API keys ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- MCP server settings (see .mcp.json and .mcp/mcp_config.example.json) ---
# Root of the repo, used by the filesystem/git servers. "." in most setups.
# WORKSPACE_ROOT=.
# Where the official memory server persists its knowledge graph.
# MEMORY_FILE_PATH=./.mcp/memory.json
# GitHub server (issues, PRs, code search).
# GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional search servers (community packages — verify the name before use).
# BRAVE_API_KEY=
# TAVILY_API_KEY=
