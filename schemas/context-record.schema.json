{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed context record projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "type", "priority", "superseded_by", "body", "raw_body", "path", "source_sha256", "scope", "category", "tasks", "source_ref"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "type": {"type": "string", "enum": ["decision", "risk", "fact", "preference"]},
    "priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "superseded_by": {"type": "string", "maxLength": 64},
    "body": {"type": "string", "minLength": 1, "maxLength": 16384},
    "raw_body": {"type": "string", "minLength": 1, "maxLength": 16384},
    "path": {"type": "string", "maxLength": 240},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"type": "string", "enum": ["global", "task", "archive"]},
    "category": {"type": "string", "enum": ["decision", "risk", "fact", "preference", "example", "hypothesis"]},
    "tasks": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}},
    "source_ref": {"type": "string", "maxLength": 64}
  }
}
