{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooperative private task state v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "task", "owner", "revision", "state", "attempt", "attempt_id", "depends_on", "baseline_sha256", "review_sha256", "history", "next_action"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "project_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {"type": "object"},
    "owner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 300},
    "revision": {"type": "integer", "minimum": 1, "maximum": 32},
    "state": {"type": "string", "enum": ["queued", "running", "review", "accepted", "blocked", "cancelled"]},
    "attempt": {"type": "integer", "minimum": 0, "maximum": 6},
    "attempt_id": {"type": "string", "maxLength": 32},
    "depends_on": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}},
    "baseline_sha256": {"type": "string", "maxLength": 64},
    "review_sha256": {"type": "string", "maxLength": 64},
    "history": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["action", "revision", "at"],
      "properties": {
        "action": {"type": "string", "enum": ["create", "start", "submit", "accept", "block", "cancel", "note"]},
        "revision": {"type": "integer", "minimum": 1, "maximum": 32},
        "at": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }},
    "result": {"type": "object"},
    "parent_verification": {"type": "object"}
  }
}
